# Bu dosyayi .env olarak kopyala ve degerleri doldur.
# docker-compose.yml bu dosyayi otomatik okur; .env git'e commit edilmemeli.

# Zorunlu: en az 32 byte rastgele deger. Uretmek icin:
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
SOC_SECRET_KEY=

# Yalnizca TLS/HTTPS arkasinda (ters proxy) yayin yapiliyorsa 1 yap.
SOC_COOKIE_SECURE=0
